{
  "name": "dicionario_visual_front",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:css": "stylelint \"app/**/*.css\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "next build && playwright test",
    "test:e2e:ui": "playwright test --ui",
    "validar:html": "html-validate \"out/**/*.html\"",
    "validar:w3c": "java -jar node_modules/vnu-jar/build/dist/vnu.jar --errors-only --skip-non-html --also-check-css --filterfile tests/padroes/w3c-filtros.txt out",
    "test:padroes": "next build && eslint --max-warnings 0 && npm run lint:css && npm run validar:html && npm run validar:w3c",
    "test:acessibilidade": "next build && playwright test acessibilidade teclado"
  },
  "dependencies": {
    "next": "16.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.1",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^22.20.7",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "html-validate": "^10.9.0",
    "jsdom": "^29.1.1",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.1.2",
    "vnu-jar": "^26.11.26"
  },
  "overrides": {
    "html-validate": {
      "vitest": "$vitest"
    }
  }
}
