{
  "extends": ["stylelint-config-standard"],
  "rules": {
    "at-rule-no-unknown": [
      true,
      { "ignoreAtRules": ["theme", "custom-variant", "utility", "variant", "source", "plugin", "apply", "reference", "config"] }
    ],
    "import-notation": "string",
    "value-keyword-case": ["lower", { "ignoreProperties": ["/^--font-/"] }]
  }
}
